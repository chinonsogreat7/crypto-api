{
  "name": "crypto-trade-api",
  "version": "1.0.0",
  "description": "TypeScript teaching API for a crypto trading mobile app with admin operations.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "db:push": "tsx scripts/db-push.ts && prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "tsx watch src/server.ts",
    "postinstall": "node scripts/render-postinstall.cjs",
    "prisma:studio": "prisma studio",
    "render-build": "cp prisma/schema.postgres.prisma prisma/schema.prisma && node scripts/render-db-compat.cjs && npx prisma generate && npx prisma db push && npm run build",
    "start": "node dist/src/server.js",
    "smoke": "tsx scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "crypto",
    "fintech",
    "typescript",
    "rest-api",
    "teaching"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.2",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
